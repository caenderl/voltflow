# Off-site backup config for scripts/backup-offsite.sh.
# Copy to scripts/backup.env (gitignored — it holds secrets) and fill in.
# The file is sourced by the script (set -a), so use `export`ed shell vars.

# --- restic repository (Google Drive via rclone) -----------------------------
# restic has no native Google Drive backend but reaches it through rclone.
# Install rclone and create a remote first:  rclone config  -> new remote
# "gdrive", type "drive", walk through the OAuth flow.
export RESTIC_REPOSITORY="rclone:gdrive:voltflow-backups"   # rclone:<remote>:<path>
# Password ENCRYPTS the whole repo. Store it safely & separately (password
# manager) — WITHOUT IT EVERY BACKUP IS UNRECOVERABLE.
export RESTIC_PASSWORD="CHANGE-ME-to-a-long-random-passphrase"
# Auth is handled entirely by rclone — no cloud keys belong here.
#
# TIP: create your OWN Google OAuth client ID (Google Cloud console, enable the
# Drive API) and enter it in `rclone config`. With rclone's shared default
# client Google throttles you (rateLimitExceeded / slow uploads).
# Headless server: run `rclone authorize "drive"` on a desktop and paste the
# token into `rclone config` on the server.

# --- alternative: Backblaze B2 (comment out the rclone block above) -----------
# export RESTIC_REPOSITORY="b2:voltflow-backups"      # b2:<bucket>[:<path>]
# export B2_ACCOUNT_ID="your-keyID"
# export B2_ACCOUNT_KEY="your-applicationKey"

# --- alternative: S3 / MinIO -------------------------------------------------
# export RESTIC_REPOSITORY="s3:s3.eu-central-1.amazonaws.com/voltflow-backups"
# export AWS_ACCESS_KEY_ID="..."
# export AWS_SECRET_ACCESS_KEY="..."

# --- retention (GFS), optional overrides -------------------------------------
export KEEP_DAILY=14
export KEEP_WEEKLY=8
export KEEP_MONTHLY=12

# --- optional dead-man's-switch (alerts if a run fails or stops happening) ----
# Create a check at healthchecks.io (or self-hosted) and paste its ping URL:
# export HEALTHCHECK_URL="https://hc-ping.com/your-uuid-here"
