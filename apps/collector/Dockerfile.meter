# Anker smart meter collector (MQTT).  Build context = apps/collector
FROM python:3.14-slim
WORKDIR /app

# git is required for the pip install of anker-solix-api from GitHub
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Runtime deps at the exact versions in the lockfile (see
# scripts/lock-collector-deps.sh), plus anker-solix-api pinned to a fixed
# commit (reproducibility + supply-chain protection). --no-deps: its runtime
# deps are in the lockfile, so nothing is resolved past it.
COPY requirements-meter.lock ./
RUN pip install --no-cache-dir -r requirements-meter.lock \
    && pip install --no-cache-dir --no-deps \
       "git+https://github.com/thomluther/anker-solix-api.git@864ea5c061fa5312949756635a3840c1b68cd2bb"

COPY . /app

# Run as a non-root user
RUN useradd --create-home --uid 1000 appuser && chown -R appuser:appuser /app
USER appuser

ENV COLLECTOR=meter
CMD ["python", "collector.py"]
